+
+#endif	// qAndroid
+
+/*****************************************************************************/
+
+#if qWinOS
+
+/*****************************************************************************/
+
+dng_file_stream::dng_file_stream (const wchar_t *filename,
+								  bool output,
+								  uint32 bufferSize)
+
+	:	dng_stream ((dng_abort_sniffer *) NULL,
+					bufferSize,
+					0)
+	
+	,	fFile (NULL)
+	
+	{
+
+	fFile = _wfopen (filename, output ? L"wb" : L"rb");
+
+	if (!fFile)
+		{
+		
+		#if qDNGValidate
+
+		char filenameCString[256];
+
+		size_t returnCount;
