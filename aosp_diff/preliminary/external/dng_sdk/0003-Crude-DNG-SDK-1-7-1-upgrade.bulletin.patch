+										(1.0 - kSceneProxyCurveSlope) * y * y * y)) < 0.0000001,
+						"SceneProxyCurve round trip error");
+
+			#endif
+
+			return y;
+		
+			}
+		
+		virtual real64 EvaluateOutput (real64 x) const override
