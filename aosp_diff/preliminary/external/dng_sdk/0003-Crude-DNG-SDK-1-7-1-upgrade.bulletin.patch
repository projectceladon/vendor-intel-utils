+		{
+		
+		if (DepthMap ()->Bounds () != fStage3Image->Bounds ())
+			{
+			
+			// If we are upsampling, and have not grabbed the raw depth map
+			// yet, do so now.
+			
+			if (!fRawDepthMap.Get ())
+				{
