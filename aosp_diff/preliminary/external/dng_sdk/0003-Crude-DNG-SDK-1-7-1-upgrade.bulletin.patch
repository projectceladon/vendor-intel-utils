+						prevRowBuf [col + 1] [2] = (ComponentType) p2;
+					
+						curRowBuf [col	  ] [2] = (ComponentType) p2;
+						curRowBuf [col + 1] [2] = (ComponentType) p2;
+					
+						}
+									
+					}
