+DNG_ALWAYS_INLINE real32 EncodeOverrange (real32 x)
+	{
+
+	x = Max_real32 (x, 0.0f);
+
+	return x * (256.0f + x) / (256.0f * (1.0f + x));
+	
+	}
+
+/*****************************************************************************/
+
+DNG_ALWAYS_INLINE real32 DecodeOverrange (real32 x)
+	{
+
+	x = Max_real32 (x, 0.0f);
+	
+	return 16.0f * ((8.0f * x) - 8.0f + sqrtf (64.0f * x * x - 127.0f * x + 64.0f));
+	
+	}
