+		}
+		
+	// Default tile size.
+		
+	if (fTileWidth == 0)
+		{
+		fTileWidth = fImageWidth;
+		}
+		
+	if (fTileLength == 0)
+		{
+		fTileLength = fImageLength;
+		}
+		
+	// Default ActiveArea.
+		
+	dng_rect imageArea (0, 0, fImageLength, fImageWidth);
