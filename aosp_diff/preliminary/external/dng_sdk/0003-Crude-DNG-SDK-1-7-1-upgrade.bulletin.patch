+class dng_big_table_dictionary : public dng_big_table_accessor
+	{
+	
+	private:
+	
+		std::map<dng_fingerprint, dng_ref_counted_block> fMap;
+		
+	public:
+	
+		const std::map<dng_fingerprint, dng_ref_counted_block> & Map () const
+			{
