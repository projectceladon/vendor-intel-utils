+		ReportError ("Unable to open file",
+					 filenameCString);
+					 
+		ThrowSilentError ();
+		
+		#else
+		
+		ThrowOpenFile ();
+		
+		#endif	// qDNGValidate
+
+		}
+	
+	}
+
+/*****************************************************************************/
+
+#endif	// qWinOS
 		
