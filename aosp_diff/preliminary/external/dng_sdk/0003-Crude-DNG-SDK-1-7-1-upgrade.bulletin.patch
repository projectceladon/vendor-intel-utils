+static void EnsureUseBoxes (JxlEncoder *enc,
+							bool &once_flag)
+	{
+	
+	if (!once_flag)
+		{
+		
+		once_flag = true;
+
+		CheckResult (JxlEncoderUseBoxes (enc),
+					 "JxlEncoderUseBoxes",
+					 nullptr);
+		
+		}
+	
+	}
