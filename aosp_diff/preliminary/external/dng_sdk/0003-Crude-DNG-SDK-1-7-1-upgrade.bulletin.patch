+		template<typename T>
+		const dng_safe_uint32 operator+ (T x) const
+			{
+			CHECK_SAFE_UINT32;
+			return dng_safe_uint32 (*this) += x;
+			}
+		
+		const dng_safe_uint32 operator* (const dng_safe_uint32 &x) const
