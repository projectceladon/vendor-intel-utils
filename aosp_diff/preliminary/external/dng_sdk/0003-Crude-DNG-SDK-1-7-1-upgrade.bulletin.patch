+		x = X [0];
+		lower = 1;
+		}
+
+	else if (x >= X [count-1])
+		{
+		x = X [count-1];
+		lower = upper;
+		}
+
+	else
+		{
+
+		// Binary search for the index.
+
+		while (upper > lower)
+			{
+
+			int32 mid = (lower + upper) >> 1;
