From 4c7f7e9b2eae006eb23df3e61ab3481509b84d5a Mon Sep 17 00:00:00 2001
From: Brian Delwiche <delwiche@google.com>
Date: Tue, 6 May 2025 17:51:32 +0000
Subject: [PATCH] Check for existing discovery database in
 bta_hf_client_cb_init

Researcher finds an RCE related to HF client discovery database.

Changes against the related issue b/291281168 (guarded by flag below)
partially resolve this issue, but it is necessary to add a check in
another location.

Bug: 374746961
Test: m libbluetooth
Test: researcher POC
Ignore-AOSP-First: security
Tag: #security
Merged-In: Ie6329743c8acdc72154b9e3774ca53e840c85478
Change-Id: I69b2e80f0dd8682dcc8862b4b9aa7845c48c3bb8
---
 system/bta/hf_client/bta_hf_client_main.cc       | 8 ++++++++
 system/bta/test/bta_dip_test.cc                  | 4 ++++
 system/bta/test/bta_hf_client_add_record_test.cc | 2 ++
 3 files changed, 14 insertions(+)

diff --git a/system/bta/hf_client/bta_hf_client_main.cc b/system/bta/hf_client/bta_hf_client_main.cc
index cae579822f..a4a09df17f 100644
--- a/system/bta/hf_client/bta_hf_client_main.cc
+++ b/system/bta/hf_client/bta_hf_client_main.cc
@@ -305,6 +305,14 @@ void bta_hf_client_cb_init(tBTA_HF_CLIENT_CB* client_cb, uint16_t handle) {
   client_cb->enabled_hf_indicators.clear();
   client_cb->peer_hf_indicators.clear();
 
+  if (client_cb->p_disc_db) {
+    if (!SDP_CancelServiceSearch(client_cb->p_disc_db)) {
+      APPL_TRACE_WARNING("Unable to cancel SDP service discovery peer: %s",
+                         client_cb->peer_addr.ToString().c_str());
+    }
+    osi_free_and_reset((void**)&client_cb->p_disc_db);
+  }
+
   // Memset the rest of the block
   // memset(client_cb, 0, sizeof(tBTA_HF_CLIENT_CB));
   *client_cb = {};
diff --git a/system/bta/test/bta_dip_test.cc b/system/bta/test/bta_dip_test.cc
index 3e71e2e6e1..4d9c595b7f 100644
--- a/system/bta/test/bta_dip_test.cc
+++ b/system/bta/test/bta_dip_test.cc
@@ -45,6 +45,10 @@ bool sdpu_compare_uuid_with_attr(const Uuid& uuid, tSDP_DISC_ATTR* p_attr) {
   return true;
 }
 
+tCONN_CB* sdpu_find_ccb_by_db(tSDP_DISCOVERY_DB const*) { return NULL; }
+
+void sdp_disconnect(tCONN_CB* p_ccb, tSDP_STATUS reason) { return; }
+
 static void sdp_dm_cback(tBTA_SDP_EVT event, tBTA_SDP* p_data,
                          void* user_data) {
   return;
diff --git a/system/bta/test/bta_hf_client_add_record_test.cc b/system/bta/test/bta_hf_client_add_record_test.cc
index 4b16cd5221..a82a1141db 100644
--- a/system/bta/test/bta_hf_client_add_record_test.cc
+++ b/system/bta/test/bta_hf_client_add_record_test.cc
@@ -48,6 +48,8 @@ bool SDP_AddUuidSequence(uint32_t handle, uint16_t attr_id, uint16_t num_uuids,
   return false;
 }
 
+bool SDP_CancelServiceSearch(void* p_disc_db) { return false; }
+
 class BtaHfClientAddRecordTest : public ::testing::Test {
  protected:
   void SetUp() override {
