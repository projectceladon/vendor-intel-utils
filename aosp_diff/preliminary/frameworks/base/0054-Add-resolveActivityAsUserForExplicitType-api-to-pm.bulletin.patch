 .../android/content/pm/PackageManager.java    | 32 +++++++++++++++--
 .../app/AbstractMultiProfilePagerAdapter.java |  2 +-
 .../internal/app/IntentForwarderActivity.java | 36 ++++++++++++++-----
 .../app/IntentForwarderActivityTest.java      | 21 ++++++++---
 5 files changed, 95 insertions(+), 24 deletions(-)

