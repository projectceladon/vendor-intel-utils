             if (mConditionProviders.subscribeIfNecessary(rule.component, rule.conditionId)) {
                 synchronized (mSubscriptions) {
-                    mSubscriptions.put(rule.conditionId, rule.component);
+                    mSubscriptions.add(uriAndCps);
                 }
